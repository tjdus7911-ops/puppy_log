# server/.env.example — 실제 값은 셸 환경변수로 넘기세요(이 파일을 커밋하지 마세요)
PORT=8787
ALLOW_ORIGIN=*
# 카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키  (카카오맵 > 사용 설정 ON 필수)
KAKAO_REST_API_KEY=
# ITS 국가교통정보센터 오픈데이터 인증키 (its.go.kr > 오픈데이터 > 돌발상황정보 > Open API 인증키 신청)
ITS_API_KEY=
# ITS_EVENT_URL=https://openapi.its.go.kr:9443/eventInfo
# Anthropic API 키 (AI 여행 일기, 선택)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
